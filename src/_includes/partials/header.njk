<header class="site-header" role="banner">
  <div class="wrap site-header__inner">
    <a href="/" class="site-header__brand" aria-label="{{ site.title }}, home">
      <span>{{ site.title }}</span>
    </a>

    <button type="button"
            class="site-nav__toggle"
            aria-expanded="false"
            aria-controls="site-nav"
            aria-label="Open menu"
            data-nav-toggle>
      <span class="site-nav__icon" aria-hidden="true">
        <span></span><span></span><span></span>
      </span>
    </button>

    <nav class="site-nav" aria-label="Primary" id="site-nav">
      <ul class="unstyled-list site-nav__list">
        {% for item in site.nav %}
          {% set isCurrent = (page.url == item.url) or (item.url != "/" and (page.url + "").indexOf(item.url) == 0) %}
          <li>
            <a class="site-nav__link" href="{{ item.url }}"{% if isCurrent %} aria-current="page"{% endif %}>{{ item.label }}</a>
          </li>
        {% endfor %}
      </ul>
    </nav>
  </div>
</header>

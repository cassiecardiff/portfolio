<!doctype html>
<html lang="en-GB">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% if title %}{{ title }} | {{ site.title }}{% else %}{{ site.title }}, {{ site.tagline }}{% endif %}</title>
  <meta name="description" content="{{ description or summary or site.description }}">
  <link rel="canonical" href="{{ site.url }}{{ page.url }}">

  <!-- Preconnect to Google Fonts for performance -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <!-- Yeseva One (display), Sora (body), Cedarville Cursive (brand name) -->
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cedarville+Cursive&family=Yeseva+One&family=Sora:wght@300;400;500;600;700&display=swap">

  <!-- Theme colour for browser chrome -->
  <meta name="theme-color" content="#f4efe6">

  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="/assets/favicon.svg">
  <link rel="alternate icon" href="/assets/favicon.svg">
  <link rel="mask-icon" href="/assets/favicon.svg" color="#2c4b63">

  <!-- Open Graph -->
  <meta property="og:title" content="{{ title or site.title }}">
  <meta property="og:description" content="{{ description or summary or site.description }}">
  <meta property="og:type" content="website">
  <meta property="og:url" content="{{ site.url }}{{ page.url }}">

  <link rel="stylesheet" href="/assets/css/main.css">

  <!-- Person schema, helps search engines connect this site to Cassie as a named researcher -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Person",
    "name": "{{ site.author.name }}",
    "alternateName": "Cassandra Cardiff",
    "url": "{{ site.url }}",
    "jobTitle": "Senior User Researcher",
    "worksFor": {
      "@type": "Organization",
      "name": "Torchbox",
      "url": "https://torchbox.com"
    },
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "London",
      "addressCountry": "GB"
    },
    "sameAs": [
      "{{ site.author.linkedin }}"
    ],
    "knowsAbout": [
      "User research",
      "AI-moderated research",
      "Accessible research",
      "Qualitative research",
      "Discovery research",
      "Charity sector research",
      "Public sector research"
    ]
  }
  </script>
</head>
<body>
  <a href="#main" class="skip-link">Skip to main content</a>

  {% include "partials/header.njk" %}

  <main id="main" tabindex="-1">
    {{ content | safe }}
  </main>

  {% include "partials/footer.njk" %}

  <script src="/assets/js/case-gate.js" defer></script>
  <script src="/assets/js/carousel.js" defer></script>
  <script src="/assets/js/nav.js" defer></script>
  <script src="/assets/js/touch-toggle.js" defer></script>
</body>
</html>

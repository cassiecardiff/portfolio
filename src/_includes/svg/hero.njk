<svg viewBox="0 0 480 420" xmlns="http://www.w3.org/2000/svg" role="img" aria-labelledby="hero-title hero-desc">
  <title id="hero-title">Three plinths beneath a soft archway, each holding a research tool</title>
  <desc id="hero-desc">A dreamlike classical scene. A magnifying glass, an open notebook with a pen and a speech bubble sit on three stone plinths under a stone arch.</desc>

  <defs>
    <linearGradient id="sky" x1="0" x2="0" y1="0" y2="1">
      <stop offset="0%" stop-color="#eaf1f6"/>
      <stop offset="100%" stop-color="#f4efe6"/>
    </linearGradient>
    <linearGradient id="stone" x1="0" x2="0" y1="0" y2="1">
      <stop offset="0%" stop-color="#f7f4ee"/>
      <stop offset="100%" stop-color="#e8e1d4"/>
    </linearGradient>
    <!-- Clips the drifting clouds to the circular sky background -->
    <clipPath id="sky-clip">
      <circle cx="225" cy="180" r="170"/>
    </clipPath>
  </defs>

  <!-- Background atmosphere -->
  <circle cx="225" cy="180" r="170" fill="url(#sky)"/>

  <!-- Drifting clouds — two identical sets spaced 480 units apart so one is
       always entering as the other exits. Clipped to the sky circle. -->
  <g class="clouds" opacity="0.75" clip-path="url(#sky-clip)">
    <g class="cloud-track">
      <!-- Set 1: natural positions -->
      <ellipse cx="110" cy="100" rx="42" ry="9" fill="#fafaf7"/>
      <ellipse cx="335" cy="80" rx="55" ry="10" fill="#fafaf7"/>
      <ellipse cx="245" cy="60" rx="30" ry="6" fill="#fafaf7"/>
      <!-- Set 2: same clouds offset 480 units right for a seamless loop -->
      <ellipse cx="590" cy="100" rx="42" ry="9" fill="#fafaf7"/>
      <ellipse cx="815" cy="80" rx="55" ry="10" fill="#fafaf7"/>
      <ellipse cx="725" cy="60" rx="30" ry="6" fill="#fafaf7"/>
    </g>
  </g>

  <!-- Arch, centred over the three plinths -->
  <g>
    <path d="M125 360 L125 220 A100 100 0 0 1 325 220 L325 360 Z"
          fill="url(#stone)" opacity="0.7"/>
    <path d="M125 360 L125 220 A100 100 0 0 1 325 220 L325 360"
          fill="none" stroke="#6f93ad" stroke-width="1.5"/>
    <path d="M145 360 L145 230 A80 80 0 0 1 305 230 L305 360 Z"
          fill="#d6e4ee" opacity="0.45"/>
    <rect x="207" y="115" width="36" height="20" rx="2" fill="#f7f4ee" stroke="#6f93ad" stroke-width="1.2"/>
  </g>

  <!-- LEFT PLINTH: magnifying glass (observe) -->
  <g class="hero-plinth" transform="translate(110, 280)">
    <rect x="0" y="40" width="60" height="80" fill="url(#stone)" stroke="#a8927a" stroke-width="1"/>
    <rect x="-4" y="36" width="68" height="6" fill="#f7f4ee" stroke="#a8927a" stroke-width="1"/>
    <rect x="-4" y="114" width="68" height="6" fill="#f7f4ee" stroke="#a8927a" stroke-width="1"/>
    <g transform="translate(30, 12)">
      <g class="float-on-hover">
        <line x1="6" y1="-3" x2="16" y2="9" stroke="#2c4b63" stroke-width="4" stroke-linecap="round"/>
        <line x1="6" y1="-3" x2="16" y2="9" stroke="#9c5751" stroke-width="1.6" stroke-linecap="round"/>
        <circle cx="-3" cy="-10" r="11" fill="#fafaf7" stroke="#2c4b63" stroke-width="1.5"/>
        <circle cx="-3" cy="-10" r="11" fill="#c9dceb" opacity="0.45"/>
        <path d="M-9 -15 Q-7 -18 -3 -18" fill="none" stroke="#fafaf7" stroke-width="1.2" stroke-linecap="round" opacity="0.9"/>
      </g>
    </g>
  </g>

  <!-- MIDDLE PLINTH: open notebook with a pen (document) -->
  <g class="hero-plinth" transform="translate(195, 250)">
    <rect x="0" y="70" width="60" height="80" fill="url(#stone)" stroke="#a8927a" stroke-width="1"/>
    <rect x="-4" y="66" width="68" height="6" fill="#f7f4ee" stroke="#a8927a" stroke-width="1"/>
    <rect x="-4" y="144" width="68" height="6" fill="#f7f4ee" stroke="#a8927a" stroke-width="1"/>
    <g transform="translate(30, 40)">
      <g class="float-on-hover">
        <path d="M-22 8 Q-22 -8 0 -4 Q22 -8 22 8 L22 18 Q22 2 0 6 Q-22 2 -22 18 Z"
              fill="#fafaf7" stroke="#2c4b63" stroke-width="1.3"/>
        <line x1="0" y1="-4" x2="0" y2="16" stroke="#2c4b63" stroke-width="0.9"/>
        <line x1="-17" y1="3" x2="-5" y2="1" stroke="#6f93ad" stroke-width="0.7"/>
        <line x1="-17" y1="7" x2="-5" y2="5" stroke="#6f93ad" stroke-width="0.7"/>
        <line x1="-17" y1="11" x2="-5" y2="9" stroke="#6f93ad" stroke-width="0.7"/>
        <line x1="5" y1="1" x2="17" y2="3" stroke="#6f93ad" stroke-width="0.7"/>
        <line x1="5" y1="5" x2="17" y2="7" stroke="#6f93ad" stroke-width="0.7"/>
        <line x1="5" y1="9" x2="17" y2="11" stroke="#6f93ad" stroke-width="0.7"/>
        <g transform="rotate(-22 0 -8)">
          <rect x="-14" y="-10" width="26" height="3" rx="1" fill="#9c5751" stroke="#2c4b63" stroke-width="0.9"/>
          <path d="M12 -10 L17 -8.5 L12 -7 Z" fill="#2c4b63"/>
          <line x1="-10" y1="-10" x2="-10" y2="-7" stroke="#fafaf7" stroke-width="1.2"/>
        </g>
      </g>
    </g>
  </g>

  <!-- RIGHT PLINTH: speech bubble (listen) -->
  <g class="hero-plinth" transform="translate(280, 280)">
    <rect x="0" y="40" width="60" height="80" fill="url(#stone)" stroke="#a8927a" stroke-width="1"/>
    <rect x="-4" y="36" width="68" height="6" fill="#f7f4ee" stroke="#a8927a" stroke-width="1"/>
    <rect x="-4" y="114" width="68" height="6" fill="#f7f4ee" stroke="#a8927a" stroke-width="1"/>
    <g transform="translate(30, 14)">
      <g class="float-on-hover">
        <rect x="-20" y="-20" width="40" height="24" rx="4" fill="#c9dceb" stroke="#2c4b63" stroke-width="1.4"/>
        <path d="M-10 4 L-8 12 L-3 4 Z" fill="#c9dceb" stroke="#2c4b63" stroke-width="1.4" stroke-linejoin="round"/>
        <circle cx="-8" cy="-8" r="1.8" fill="#2c4b63"/>
        <circle cx="0" cy="-8" r="1.8" fill="#2c4b63"/>
        <circle cx="8" cy="-8" r="1.8" fill="#2c4b63"/>
      </g>
    </g>
  </g>

  <!-- Ground line -->
  <line x1="40" y1="400" x2="440" y2="400" stroke="#a8927a" stroke-width="1" opacity="0.5"/>
</svg>

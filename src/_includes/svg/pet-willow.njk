<svg viewBox="0 0 160 160" xmlns="http://www.w3.org/2000/svg" role="img" aria-labelledby="willow-title">
  <title id="willow-title">Willow, a curled up sleeping cat</title>

  <!-- soft shadow -->
  <ellipse cx="80" cy="142" rx="58" ry="3" fill="#a8927a" opacity="0.2"/>

  <!-- curled body as one path: head tucked into a sleepy curl with tail wrapping over the back -->
  <path d="
    M 26 102
    C 22 86 32 72 50 70
    C 60 69 66 74 70 80
    C 76 70 92 64 110 68
    C 132 72 142 92 138 112
    C 134 128 116 138 96 138
    L 50 138
    C 32 138 24 124 26 102
    Z
  " fill="#c9dceb" stroke="#2c4b63" stroke-width="1.5" stroke-linejoin="round"/>

  <!-- ears (tucked, low and forward) -->
  <path d="M 38 76 L 36 64 L 50 72 Z" fill="#c9dceb" stroke="#2c4b63" stroke-width="1.3" stroke-linejoin="round"/>
  <path d="M 60 74 L 64 64 L 54 70 Z" fill="#c9dceb" stroke="#2c4b63" stroke-width="1.3" stroke-linejoin="round"/>

  <!-- closed eyes (peaceful arcs) -->
  <path d="M 38 92 Q 42 95 46 92" fill="none" stroke="#2c4b63" stroke-width="1.4" stroke-linecap="round"/>
  <path d="M 54 91 Q 58 94 62 91" fill="none" stroke="#2c4b63" stroke-width="1.4" stroke-linecap="round"/>

  <!-- little nose -->
  <path d="M 50 100 L 52 102 L 48 102 Z" fill="#c97b73" stroke="#2c4b63" stroke-width="0.6"/>

  <!-- whiskers, dreaming -->
  <path d="M 28 100 L 40 101" stroke="#2c4b63" stroke-width="0.8" stroke-linecap="round" fill="none" opacity="0.7"/>
  <path d="M 56 101 L 68 100" stroke="#2c4b63" stroke-width="0.8" stroke-linecap="round" fill="none" opacity="0.7"/>

  <!-- tail wrapping over the back -->
  <path d="M 138 100 Q 145 82 122 76 Q 100 72 88 86"
        fill="none" stroke="#c9dceb" stroke-width="10" stroke-linecap="round"/>
  <path d="M 138 100 Q 145 82 122 76 Q 100 72 88 86"
        fill="none" stroke="#2c4b63" stroke-width="1.5" stroke-linecap="round"/>

  <!-- z's that float upward — each one loops independently with a staggered delay -->
  <g fill="#6f93ad" font-family="Sora, sans-serif">
    <text class="willow-z willow-z--1" x="108" y="58" font-size="9">z</text>
    <text class="willow-z willow-z--2" x="118" y="58" font-size="11">z</text>
    <text class="willow-z willow-z--3" x="112" y="58" font-size="8">z</text>
  </g>
</svg>

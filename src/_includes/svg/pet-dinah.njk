<svg viewBox="0 0 200 160" xmlns="http://www.w3.org/2000/svg" role="img" aria-labelledby="dinah-title">
  <title id="dinah-title">Dinah, a whippet standing</title>

  <!-- soft shadow -->
  <ellipse cx="105" cy="148" rx="62" ry="3" fill="#a8927a" opacity="0.2"/>

  <!-- legs, filled and tapered, drawn first so the body covers their tops -->
  <g fill="#f3dedb" stroke="#2c4b63" stroke-width="1.5" stroke-linejoin="round">
    <path d="M 64 98 L 62 142 L 70 142 L 72 98 Z"/>
    <path d="M 80 98 L 78 142 L 86 142 L 88 98 Z"/>
    <path d="M 122 98 L 124 142 L 132 142 L 130 98 Z"/>
    <path d="M 138 98 L 140 142 L 148 142 L 146 98 Z"/>
  </g>

  <!-- paws (slightly darker, sit at the bottom of each leg) -->
  <g fill="#e8e1d4" stroke="#2c4b63" stroke-width="1.2">
    <ellipse cx="66" cy="142" rx="5" ry="2.4"/>
    <ellipse cx="82" cy="142" rx="5" ry="2.4"/>
    <ellipse cx="128" cy="142" rx="5" ry="2.4"/>
    <ellipse cx="144" cy="142" rx="5" ry="2.4"/>
  </g>

  <!-- body, lean whippet shape, covers the top of the legs -->
  <path d="M 55 90 Q 70 70 110 75 Q 140 78 150 88 Q 155 102 142 106 L 60 106 Q 48 102 55 90 Z"
        fill="#f3dedb" stroke="#2c4b63" stroke-width="1.5" stroke-linejoin="round"/>

  <!-- chest tuck curves -->
  <path d="M 62 106 Q 70 116 80 110" fill="none" stroke="#2c4b63" stroke-width="1.2" stroke-linecap="round"/>
  <path d="M 130 106 Q 138 114 144 110" fill="none" stroke="#2c4b63" stroke-width="1.2" stroke-linecap="round"/>

  <!-- neck and head, elegant -->
  <path d="M 150 88 Q 165 75 175 60 Q 182 50 178 38 Q 174 28 165 30 Q 150 35 148 50 Q 146 65 150 88 Z"
        fill="#f3dedb" stroke="#2c4b63" stroke-width="1.5" stroke-linejoin="round"/>

  <!-- ear, rose petal whippet style -->
  <path d="M 165 30 Q 160 18 168 22 Q 175 28 172 38 Z"
        fill="#c97b73" opacity="0.65" stroke="#2c4b63" stroke-width="1.2" stroke-linejoin="round"/>

  <!-- eye -->
  <circle cx="170" cy="48" r="1.6" fill="#2c4b63"/>

  <!-- nose -->
  <circle cx="180" cy="42" r="2" fill="#2c4b63"/>

  <!-- mouth -->
  <path d="M 176 47 Q 172 50 168 48" fill="none" stroke="#2c4b63" stroke-width="1.2" stroke-linecap="round"/>

  <!-- bark waves — 3 right-facing arcs radiating from the mouth -->
  <g class="dinah-bark" aria-hidden="true">
    <path class="dinah-bw dinah-bw-1" d="M 182 45 A 5 5 0 0 1 182 55"  fill="none" stroke="#2c4b63" stroke-width="1.5" stroke-linecap="round" opacity="0"/>
    <path class="dinah-bw dinah-bw-2" d="M 182 42 A 8 8 0 0 1 182 58"  fill="none" stroke="#2c4b63" stroke-width="1.3" stroke-linecap="round" opacity="0"/>
    <path class="dinah-bw dinah-bw-3" d="M 182 39 A 11 11 0 0 1 182 61" fill="none" stroke="#2c4b63" stroke-width="1.1" stroke-linecap="round" opacity="0"/>
  </g>

  <!-- collar -->
  <path d="M 152 75 Q 160 78 158 85" fill="none" stroke="#9c5751" stroke-width="2.5" stroke-linecap="round"/>

  <!-- tail, long thin curve -->
  <path d="M 55 92 Q 35 95 30 75 Q 28 65 35 60" fill="none" stroke="#2c4b63" stroke-width="2.5" stroke-linecap="round"/>
</svg>

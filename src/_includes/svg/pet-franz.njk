<svg viewBox="0 0 160 160" xmlns="http://www.w3.org/2000/svg" role="img" aria-labelledby="franz-title">
  <title id="franz-title">Franz, a tabby cat sitting</title>
  <g fill="none" stroke="#2c4b63" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
    <!-- body -->
    <path d="M 55 130 Q 40 100 50 75 Q 55 50 80 50 Q 105 50 110 75 Q 120 100 105 130 Z" fill="#e8e1d4"/>
    <!-- head -->
    <circle cx="80" cy="55" r="26" fill="#f4efe6"/>
    <!-- ears -->
    <path d="M60 38 L58 22 L74 35 Z" fill="#e8e1d4"/>
    <path d="M100 38 L102 22 L86 35 Z" fill="#e8e1d4"/>
    <path d="M64 33 L62 25 L70 32" fill="#c97b73" opacity="0.5"/>
    <path d="M96 33 L98 25 L90 32" fill="#c97b73" opacity="0.5"/>
    <!-- eyes -->
    <ellipse cx="71" cy="56" rx="2.5" ry="3.5" fill="#2c4b63" stroke="none"/>
    <ellipse cx="89" cy="56" rx="2.5" ry="3.5" fill="#2c4b63" stroke="none"/>
    <!-- nose and mouth -->
    <path d="M78 65 L80 67 L82 65 Z" fill="#c97b73" stroke="none"/>
    <path d="M80 67 L80 70 M80 70 Q76 73 73 71 M80 70 Q84 73 87 71"/>
    <!-- tongue — hidden by default, pokes out on hover/touch -->
    <g class="franz-tongue" aria-hidden="true">
      <path d="M77 70 Q77 78 80 79 Q83 78 83 70 Z" fill="#c97b73" stroke="#2c4b63" stroke-width="0.8" stroke-linejoin="round"/>
    </g>
    <!-- whiskers -->
    <line x1="55" y1="64" x2="68" y2="65"/>
    <line x1="55" y1="68" x2="68" y2="68"/>
    <line x1="92" y1="65" x2="105" y2="64"/>
    <line x1="92" y1="68" x2="105" y2="68"/>
    <!-- tabby stripes -->
    <path d="M70 40 L74 48" opacity="0.5"/>
    <path d="M80 38 L80 48" opacity="0.5"/>
    <path d="M90 40 L86 48" opacity="0.5"/>
    <!-- tail — wrapped in a group so the CSS can swing it from its base -->
    <g class="franz-tail">
      <path d="M105 125 Q130 120 125 95" fill="none"/>
    </g>
    <!-- paws -->
    <ellipse cx="65" cy="135" rx="8" ry="4" fill="#f4efe6"/>
    <ellipse cx="95" cy="135" rx="8" ry="4" fill="#f4efe6"/>
  </g>
</svg>

<svg viewBox="0 0 80 120" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
  <defs>
    <linearGradient id="plinth-dog-stone" x1="0" x2="0" y1="0" y2="1">
      <stop offset="0%" stop-color="#f7f4ee"/>
      <stop offset="100%" stop-color="#e8e1d4"/>
    </linearGradient>
  </defs>

  <!-- Horizontal bone, sitting just above the plinth cap (y=44).
       Bottom of bone at y=44 so it rests on the cap. -->
  <g class="float-on-hover">
    <!-- left lobes -->
    <circle cx="22" cy="33" r="5" fill="#c9dceb" stroke="#2c4b63" stroke-width="1.4"/>
    <circle cx="22" cy="39" r="5" fill="#c9dceb" stroke="#2c4b63" stroke-width="1.4"/>
    <!-- right lobes -->
    <circle cx="58" cy="33" r="5" fill="#c9dceb" stroke="#2c4b63" stroke-width="1.4"/>
    <circle cx="58" cy="39" r="5" fill="#c9dceb" stroke="#2c4b63" stroke-width="1.4"/>
    <!-- shaft -->
    <rect x="22" y="33" width="36" height="6" rx="2" fill="#c9dceb" stroke="#2c4b63" stroke-width="1.4"/>
    <!-- mask the inner stroke between lobes and shaft -->
    <rect x="22.5" y="33.7" width="35" height="4.6" fill="#c9dceb" stroke="none"/>
    <!-- subtle highlight along the shaft -->
    <line x1="26" y1="35.5" x2="54" y2="35.5" stroke="#fafaf7" stroke-width="1" opacity="0.55"/>
  </g>

  <!-- Plinth -->
  <g>
    <rect x="14" y="48" width="52" height="60" fill="url(#plinth-dog-stone)" stroke="#a8927a" stroke-width="1"/>
    <rect x="10" y="44" width="60" height="6" fill="#f7f4ee" stroke="#a8927a" stroke-width="1"/>
    <rect x="10" y="106" width="60" height="6" fill="#f7f4ee" stroke="#a8927a" stroke-width="1"/>
    <line x1="22" y1="56" x2="22" y2="100" stroke="#a8927a" stroke-width="0.5" opacity="0.6"/>
    <line x1="58" y1="56" x2="58" y2="100" stroke="#a8927a" stroke-width="0.5" opacity="0.6"/>
  </g>
</svg>

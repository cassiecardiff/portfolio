<svg viewBox="0 0 80 120" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
  <defs>
    <linearGradient id="plinth-globe-stone" x1="0" x2="0" y1="0" y2="1">
      <stop offset="0%" stop-color="#f7f4ee"/>
      <stop offset="100%" stop-color="#e8e1d4"/>
    </linearGradient>
  </defs>
  <g class="float-on-hover">
    <!-- globe, simplified meridians and equator -->
    <circle cx="40" cy="28" r="16" fill="#c9dceb" stroke="#2c4b63" stroke-width="1.2"/>
    <!-- equator -->
    <ellipse cx="40" cy="28" rx="16" ry="5" fill="none" stroke="#2c4b63" stroke-width="0.9"/>
    <!-- meridian vertical -->
    <ellipse cx="40" cy="28" rx="6" ry="16" fill="none" stroke="#2c4b63" stroke-width="0.9"/>
    <!-- a tilted meridian for depth -->
    <ellipse cx="40" cy="28" rx="12" ry="16" fill="none" stroke="#2c4b63" stroke-width="0.6" opacity="0.6"/>
  </g>
  <g>
    <rect x="14" y="48" width="52" height="60" fill="url(#plinth-globe-stone)" stroke="#a8927a" stroke-width="1"/>
    <rect x="10" y="44" width="60" height="6" fill="#f7f4ee" stroke="#a8927a" stroke-width="1"/>
    <rect x="10" y="106" width="60" height="6" fill="#f7f4ee" stroke="#a8927a" stroke-width="1"/>
    <line x1="22" y1="56" x2="22" y2="100" stroke="#a8927a" stroke-width="0.5" opacity="0.6"/>
    <line x1="58" y1="56" x2="58" y2="100" stroke="#a8927a" stroke-width="0.5" opacity="0.6"/>
  </g>
</svg>
